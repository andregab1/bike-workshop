{
  "name": "bike-workshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src public/bikeflow.js public/inventory-ui.js eslint.config.mjs next.config.ts prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:frontend": "node --check public/bikeflow.js && node --check public/inventory-ui.js",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:native:init": "C:\\Progra~1\\PostgreSQL\\18\\bin\\initdb.exe -D .postgres-data --encoding=UTF8 --locale=C --auth=trust --username=bikeflow",
    "db:native:start": "C:\\Progra~1\\PostgreSQL\\18\\bin\\pg_ctl.exe -D .postgres-data -l .postgres.log -o \"-p 5433 -h 127.0.0.1\" start",
    "db:native:create": "C:\\Progra~1\\PostgreSQL\\18\\bin\\createdb.exe -h 127.0.0.1 -p 5433 -U bikeflow bikeflow",
    "db:native:stop": "C:\\Progra~1\\PostgreSQL\\18\\bin\\pg_ctl.exe -D .postgres-data stop",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.7.1",
    "dotenv": "^17.4.2",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
